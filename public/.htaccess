<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Force HTTPS for local waldo
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^waldo(:[0-9]+)?$ [NC]
    RewriteRule ^ https://waldo%{REQUEST_URI} [L,R=301]

    # Proxy WebSocket connections to Laravel Reverb
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^app/(.*) ws://127.0.0.1:8080/app/$1 [P,L]
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^app$ ws://127.0.0.1:8080/app [P,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Route icons to pwa-icons folder (bypass Apache default /icons/ alias)
    RewriteRule ^icons/(.*)$ pwa-icons/$1 [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Disable QUIC/HTTP3 for Livewire endpoints to prevent ERR_QUIC_GOAWAY errors
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m|^/livewire|">
        Header always set Alt-Svc "clear"
        Header always set Cache-Control "no-store, no-cache, must-revalidate"
    </If>
</IfModule>

# Fix 412 Precondition Failed for media files served from /storage/
# LiteSpeed WAF blocks .webm and other media types by default.
# Explicitly declare MIME types and allow direct file access.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType audio/webm          .webm
    AddType audio/ogg           .ogg .oga
    AddType audio/mpeg          .mp3
    AddType audio/wav           .wav
    AddType video/webm          .webm
    AddType video/mp4           .mp4
    AddType image/webp          .webp
</IfModule>

<IfModule mod_headers.c>
    # Allow media file range requests (required for audio/video seeking)
    <FilesMatch "\.(webm|ogg|oga|mp3|mp4|wav|webp)$">
        Header always set Accept-Ranges "bytes"
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>

    # Ensure Service Worker is never cached by HTTP headers
    <FilesMatch "^sw\.js$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>
</IfModule>

# Increase upload size limits for Apache/LiteSpeed PHP
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>

